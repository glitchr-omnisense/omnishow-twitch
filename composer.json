{
    "name": "omnishow/twitch",
    "type": "library",
    "description": "Omnishow's Twitch, under any PHP host: whether a channel is live, its stream (title, category, viewers, start, thumbnail, its player) and its schedule, cancelled segments said - through the Helix API with an app access token from the application's client id and secret.",
    "keywords": [
        "twitch",
        "helix",
        "live",
        "stream",
        "schedule",
        "framework-agnostic",
        "omnishow"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnishow-twitch",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnishow": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnishow\\Twitch\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnishow\\Twitch\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
